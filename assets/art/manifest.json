{
  "name": "Codex Spirit Companion Art Kit",
  "version": 1,
  "style": {
    "body": "jade green",
    "belly": "warm cream",
    "horns": "antique gold",
    "blush": "coral",
    "outline": "thick dark pixel outline"
  },
  "assets": [
    {
      "id": "taotie-evolution-reference",
      "path": "references/taotie-evolution-reference.png",
      "type": "reference",
      "usage": "Five-stage visual direction only"
    },
    {
      "id": "taotie-mini",
      "path": "sprites/taotie-mini.svg",
      "type": "sprite-mark",
      "usage": "Static mascot mark for documentation and share cards"
    },
    {
      "id": "taotie-state-sheet",
      "path": "sprites/taotie-state-sheet.svg",
      "type": "state-sheet",
      "usage": "Visual spec for desktop pet life states"
    },
    {
      "id": "pet-states",
      "path": "states.json",
      "type": "state-data",
      "usage": "State labels, triggers, and visual notes"
    },
    {
      "id": "state-glyphs",
      "path": "state-glyphs.json",
      "type": "pixel-glyph-data",
      "usage": "Tiny runtime state icons shared by desktop pet and art-kit preview"
    },
    {
      "id": "cosmetic-anchors",
      "path": "cosmetic-anchors.json",
      "type": "anchor-data",
      "usage": "Stable head, neck, and back slots for future dress-up items"
    },
    {
      "id": "art-kit-page-script",
      "path": "../../art-kit.js",
      "type": "preview-script",
      "usage": "Renders state data cards in art-kit.html"
    },
    {
      "id": "jade-slip",
      "path": "icons/jade-slip.svg",
      "type": "icon",
      "usage": "File feeding and jade-slip output records"
    },
    {
      "id": "art-tokens",
      "path": "tokens.css",
      "type": "tokens",
      "usage": "Shared color tokens for browser UI and future art pages"
    }
  ]
}
